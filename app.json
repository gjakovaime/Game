{
  "expo": {
    "name": "Albanian Adventures",
    "slug": "albanian-adventures",
    "version": "1.0.0",
    "scheme": "albanian-adventures",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F5A623"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.luajshqip.appname",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5A623"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.luajshqip.appname"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ],
    "extra": {
      "eas": {
        "projectId": "d3970ab0-dbd8-4421-bf01-d318ade78f70"
      }
    },
    "owner": "gjakovaime"
  }
}
